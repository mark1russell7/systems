{
  "$comment": "The site config of this repository (CI.md of the template, \"The site config\"). The Pages workflow deploys this site from main, and a job of ci.yml checks it on each pull request.",
  "build": "pnpm --filter @systems/site run build",
  "out": "packages/site/dist",
  "env": {
    "SITE_BASE": "/{repo}",
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "site-pages": true,
  "roadmap": "docs/ROADMAP.md",
  "packages": "@mark1russell7/automata,@mark1russell7/harness,@mark1russell7/kind,@mark1russell7/machines,@mark1russell7/prober,@mark1russell7/quantity,@mark1russell7/service",
  "site-name": "systems",
  "site-check": true,
  "data-stamps": "packages/site/dist/data-stamps.json",
  "site-check-pages": "/,/releases/,/status/,/results/cells/",
  "site-check-probe": "packages/site/src/check-probe.ts"
}
