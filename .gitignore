# Claude Code
.claude/
.mcp.json

# Local data
_db/

# Markdown files at the root. Git ignores each one that is not on the allowlist below,
# for example the notes of a research session. Thus `git add .` does not commit them by
# accident. To keep a new document at the root, add a line for it to the allowlist.
/*.md
!/CLAUDE.md
!/README.md
!/RELEASING.md

# Local ste-lint dictionaries. The ASD-STE100 dictionary is copyrighted: do not commit it.
.ste/
*.ste-dictionary.json

# Tokens / API keys
*.token
*sensitive*

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
