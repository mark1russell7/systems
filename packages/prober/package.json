{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/prober",
  "version": "0.1.0",
  "description": "An eBPF prober for TCP: a CO-RE kernel program and its Rust collector, which record what the kernel did to each socket, with the record contract in TypeScript.",
  "keywords": [
    "ebpf",
    "bpf",
    "libbpf",
    "co-re",
    "tcp",
    "keepalive",
    "retransmission",
    "linux",
    "observability"
  ],
  "homepage": "https://mark1russell7.github.io/systems/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/systems.git",
    "directory": "packages/prober"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/systems/issues"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "bpf/prober.bpf.c",
    "bpf/prober.h",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "fixtures/records.bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json",
    "fixture": "node src/write-fixture.ts",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs && pnpm build"
  },
  "dependencies": {
    "@mark1russell7/quantity": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
