{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/algebra",
  "version": "0.7.2",
  "description": "State machines as data, and the timer algebra over them: closed forms for a machine's timers in exact rationals, detection as the first live timer, recovery after a stall, and the replay of a trace.",
  "keywords": [
    "state-machine",
    "timers",
    "tcp",
    "keepalive",
    "retransmission",
    "failure-detection",
    "timeouts",
    "rational"
  ],
  "homepage": "https://mark1russell7.github.io/systems/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/systems.git",
    "directory": "packages/algebra"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/systems/issues"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./replay": "./src/replay.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs && pnpm build"
  },
  "dependencies": {
    "@mark1russell7/quantity": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./replay": {
        "types": "./build/replay.d.ts",
        "default": "./build/replay.js"
      },
      "./package.json": "./package.json"
    }
  }
}
