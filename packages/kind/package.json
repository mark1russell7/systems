{
  "$schema": "https://json.schemastore.org/package",
  "name": "@systems/kind",
  "version": "0.1.0",
  "private": true,
  "description": "Kubernetes in Docker as an environment of the systems program: a kind cluster from a scenario, faults in the namespaces of its pods, observations on the one monotonic clock of the VM, and predictions from the ordering law.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mark1russell7/harness": "workspace:^",
    "@mark1russell7/quantity": "workspace:^",
    "@mark1russell7/service": "workspace:^",
    "testcontainers": "12.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
