{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/harness",
  "version": "0.11.22",
  "description": "A fault-injection harness for connection timers: a cell runs a client against a stock target in Docker, through a topology of routers and proxies, a replicated group under Sentinels or a replica set, injects a fault, measures the kernel's own records and judges a prediction. HTTP clients of Go, Node and undici race the keep-alive of a Node server, and the MongoDB driver meets the faults of a replica set. The WebSocket client of @procedures/client drops a silent connection on its own heartbeat, and the harness times that detection and the reconnect from the program's lines and the kernel's stamps.",
  "keywords": [
    "fault-injection",
    "chaos-engineering",
    "tcp",
    "keepalive",
    "timeouts",
    "testcontainers",
    "docker",
    "ebpf"
  ],
  "homepage": "https://mark1russell7.github.io/systems/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/systems.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/systems/issues"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "image/Dockerfile",
    "image/native/Cargo.toml",
    "image/native/Cargo.lock",
    "image/native/src",
    "image/node/Dockerfile",
    "image/node/client-ioredis.mjs",
    "image/node/client-sentinel.mjs",
    "image/node/observer.mjs",
    "image/node/package.json",
    "image/node/npm-lock.json",
    "image/go-http/Dockerfile",
    "image/go-http/go.mod",
    "image/go-http/main.go",
    "image/node-http/Dockerfile",
    "image/node-http/package.json",
    "image/node-http/npm-lock.json",
    "image/node-http/lines.mjs",
    "image/node-http/client-agent.mjs",
    "image/node-http/client-undici.mjs",
    "image/mongo/Dockerfile",
    "image/mongo/client-mongo.mjs",
    "image/mongo/stepdown-mongo.mjs",
    "image/mongo/package.json",
    "image/mongo/npm-lock.json",
    "image/pg/Dockerfile",
    "image/pg/client-pg.mjs",
    "image/pg/package.json",
    "image/pg/npm-lock.json",
    "image/hikari/Dockerfile",
    "image/hikari/ClientHikari.java",
    "image/hikari/jars.sha256",
    "image/amqp/Dockerfile",
    "image/amqp/client-amqp.mjs",
    "image/amqp/client-cluster.mjs",
    "image/amqp/admin-cluster.mjs",
    "image/amqp/package.json",
    "image/amqp/npm-lock.json",
    "image/grpc/Dockerfile",
    "image/grpc/client-grpc.mjs",
    "image/grpc/package.json",
    "image/grpc/npm-lock.json",
    "image/grpc-go/Dockerfile",
    "image/grpc-go/go.mod",
    "image/grpc-go/main.go",
    "image/etcd/Dockerfile",
    "image/procedures/Dockerfile",
    "image/procedures/package.json",
    "image/procedures/npm-lock.json",
    "image/procedures/lines.mjs",
    "image/procedures/client-ws.mjs",
    "image/procedures/server-ws.mjs",
    "image/router/Dockerfile",
