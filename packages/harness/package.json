    "image/pgpool/Dockerfile",
    "image/docker-proxy/Dockerfile",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs && pnpm build"
  },
  "dependencies": {
    "@mark1russell7/prober": "workspace:^",
    "@mark1russell7/quantity": "workspace:^",
    "testcontainers": "12.2.0"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./schema": {
        "types": "./build/schema.d.ts",
        "default": "./build/schema.js"
      },
      "./package.json": "./package.json"
    }
  }
}
