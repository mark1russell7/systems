  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@opentelemetry/api": "^1.9.0",
    "amqplib": "^2.2.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
