{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/service",
  "version": "0.8.0",
  "description": "A service declared as data before it starts, and its runtime: checks on jittered loops, a latch for each policy, probes from the cache, the startup in its sequence, and a staged, capped drain. The timer-ordering law checks the declaration. Its clock, heartbeat and backoff also work alone, in a browser too.",
  "keywords": [
    "service",
    "readiness",
    "liveness",
    "health-check",
    "graceful-shutdown",
    "idempotency",
    "timeouts",
    "kubernetes",
    "rate-limit"
  ],
  "homepage": "https://mark1russell7.github.io/systems/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/systems.git",
    "directory": "packages/service"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/systems/issues"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./redis": "./src/redis.ts",
    "./pg": "./src/pg.ts",
    "./mongodb": "./src/mongodb.ts",
    "./rabbitmq": "./src/rabbitmq.ts",
    "./http-client": "./src/http-client.ts",
    "./websocket": "./src/websocket.ts",
    "./grpc": "./src/grpc.ts",
    "./clock": "./src/clock.ts",
    "./channel": "./src/channel.ts",
    "./heartbeat": "./src/heartbeat.ts",
    "./backoff": "./src/backoff.ts",
    "./http": "./src/http.ts",
    "./limiter": "./src/limiter.ts",
    "./rules": "./src/rules.ts",
    "./host": "./src/host.ts",
    "./otel": "./src/otel.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs && pnpm build"
  },
  "dependencies": {
    "@mark1russell7/algebra": "workspace:^",
