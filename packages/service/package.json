    "@mark1russell7/harness": "workspace:^",
    "@mark1russell7/otel-ts": "^0.4.0",
    "@mark1russell7/rigor-testkit": "^0.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "~0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.4",
